# C++ 代码排版配置。
#
# Google 基线，缩进用 4 个空格，对齐用空格，列宽 120。

# 只处理 C++ 源文件。
Language: Cpp
# 只覆盖本文件写出的项，其余沿用预设。
BasedOnStyle: Google
# 工具不接受 c++23 取值，改用 Latest 跟随其支持的最高标准。
Standard: Latest

# include 保持现有空行分组，组内按 Google 预设排序。
IncludeBlocks: Preserve

# 每行最多 120 列。
ColumnLimit: 120
# 一级缩进 4 个空格。
IndentWidth: 4
# Tab 按 4 列显示，只用于阅读既有文件。
TabWidth: 4
# 缩进与对齐都用空格，不写 Tab。
UseTab: Never
# 续行多缩进 8 个空格。
ContinuationIndentWidth: 8
# 访问修饰符不缩进，与 class/struct 左对齐。
AccessModifierOffset: -4
# 构造函数初始化列表尽量排在一行。
PackConstructorInitializers: BinPack

# 行尾统一为 LF。
LineEnding: LF
