{
  "name": "@chengzhao-dev/dsh-cpp-workflow",
  "version": "0.3.0",
  "description": "C++11–C++23 工程流程技能包：源码四步与构建三步，按项目声明的环境组合校验 · C++11–C++23 workflow skills for DeepSeek Harness",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "files": [
    "lib",
    "skills",
    "cordis.patch.yml",
    "locale",
    "icon.svg",
    "README.md",
    "README.en.md",
    "LICENSE",
    "templates"
  ],
  "engines": {
    "node": ">=22",
    "dsh": ">=0.2.0-rc.1 <0.3.0-0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "catalog": {
      "category": "skill",
      "summary": {
        "zh": "按项目声明的环境组合，推进 C++11–C++23 源码与构建流程",
        "en": "Advance C++11–C++23 source and build work with a project-declared environment"
      },
      "capabilities": [
        "skills"
      ]
    }
  },
  "icon": "./icon.svg",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node scripts/checking-skill-links.mjs && node skills/building-cpp/scripts/checking-encoding.mjs --quiet && node --test tests/*.test.mjs",
    "check:encoding": "node skills/building-cpp/scripts/checking-encoding.mjs",
    "test:matrix": "bash scripts/checking-standard-matrix.sh",
    "pack:check": "npm pack --dry-run"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "cpp",
    "c++",
    "cplusplus",
    "cmake",
    "ninja",
    "clang",
    "gcc",
    "skills"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chengzhao-dev/dsh-cpp-workflow.git"
  },
  "homepage": "https://github.com/chengzhao-dev/dsh-cpp-workflow#readme",
  "bugs": {
    "url": "https://github.com/chengzhao-dev/dsh-cpp-workflow/issues"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-skill": ">=0.2.0-rc.1 <0.3.0-0"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-skill": ">=0.2.0-rc.1 <0.3.0-0",
    "@types/node": "^22.20.5",
    "typescript": "^5.9.3"
  }
}
