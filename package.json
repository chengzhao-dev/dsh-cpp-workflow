{
  "name": "@chengzhao-dev/dsh-cpp-workflow",
  "version": "0.6.2",
  "description": "写 C++ 源码、配 CMake、用 Clang 构建；文档注释统一为 /// Doxygen，文件头标签可在设置里改。 · Write C++ sources, configure CMake, and build with Clang; /// Doxygen comments, with file-header tags you can change in Settings.",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "files": [
    "lib",
    "skills",
    "cordis.patch.yml",
    "locale",
    "icon.svg",
    "README.md",
    "README.en.md",
    "LICENSE",
    "templates"
  ],
  "engines": {
    "node": ">=22",
    "dsh": ">=0.2.0-rc.1 <0.3.0-0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots"
      ]
    },
    "catalog": {
      "category": "skill",
      "summary": {
        "zh": "写 C++ 源码、配 CMake、用 Clang 构建；文档注释统一为 /// Doxygen，文件头标签可在设置里改。",
        "en": "Write C++ sources, configure CMake, and build with Clang; /// Doxygen comments, with file-header tags you can set in Settings."
      },
      "capabilities": [
        "skills"
      ]
    }
  },
  "icon": "./icon.svg",
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/building-client.mjs",
    "test": "npm run build && node scripts/building-client.mjs --check && node scripts/checking-skill-links.mjs && node skills/building-cpp/scripts/checking-encoding.mjs --quiet && node scripts/checking-github-workflows.mjs && node --test tests/*.test.mjs",
    "ci": "npm ci && npm test && npm run pack:check",
    "ci:full": "npm run ci && npm run test:matrix",
    "check:encoding": "node skills/building-cpp/scripts/checking-encoding.mjs",
    "check:workflows": "node scripts/checking-github-workflows.mjs",
    "test:matrix": "bash scripts/checking-standard-matrix.sh",
    "pack:check": "npm pack --dry-run"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "cpp",
    "c++",
    "cplusplus",
    "cmake",
    "ninja",
    "clang",
    "gcc",
    "skills"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chengzhao-dev/dsh-cpp-workflow.git"
  },
  "homepage": "https://github.com/chengzhao-dev/dsh-cpp-workflow#readme",
  "bugs": {
    "url": "https://github.com/chengzhao-dev/dsh-cpp-workflow/issues"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-skill": ">=0.2.0-rc.1 <0.3.0-0"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.5"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-skill": ">=0.2.0-rc.1 <0.3.0-0",
    "@types/node": "^22.20.5",
    "typescript": "^5.9.3",
    "yaml": "^2.9.1"
  }
}
