# 本仓编辑器保存时的格式约定。
#
# 覆盖编码、行尾、空白、缩进与列宽；最终行尾以 .gitattributes 为准。

# 本文件是仓库的根配置，上层目录中的 .editorconfig 不再生效。
root = true

# 适用于所有文本文件；下面的节在此基础上按文件类型补充或覆盖。
[*]
# 使用 UTF-8 编码。
charset = utf-8
# 使用 LF 行尾。
end_of_line = lf
# 文件末尾保留一个换行。
insert_final_newline = true
# 删除行尾空白。
trim_trailing_whitespace = true
# 使用空格缩进。
indent_style = space
# 每级缩进 2 个空格。
indent_size = 2

# 适用于 CMakeLists.txt 与 *.cmake。
[{CMakeLists.txt,*.cmake}]
# 使用空格缩进。
indent_style = space
# 每级缩进 4 个空格。
indent_size = 4
# 单行最多 120 列。
max_line_length = 120

# 适用于 C、C++ 源文件与头文件。
[*.{c,cc,cpp,cxx,h,hh,hpp,hxx}]
# 使用空格缩进。
indent_style = space
# 每级缩进 4 个空格。
indent_size = 4
# 单行最多 120 列。
max_line_length = 120

# 适用于 shell 脚本。
[*.sh]
# 使用空格缩进。
indent_style = space
# 每级缩进 4 个空格。
indent_size = 4
# 单行最多 120 列。
max_line_length = 120

# 适用于 Windows 批处理脚本。
[*.{bat,cmd}]
# 使用 CRLF 行尾。
end_of_line = crlf
