# 本仓文件的格式约定。

root = true

# ================================== 默认格式 ==================================
[*]

# 编码用 UTF-8，不带 BOM。
charset = utf-8

# 行尾用 LF。
end_of_line = lf

# 保存时让文件以换行结尾。
insert_final_newline = true

# 保存时删除行末空白。
trim_trailing_whitespace = true

# 缩进用空格。
indent_style = space

# 每级缩进 4 个空格。
indent_size = 4

# 每行最多 120 列。
max_line_length = 120

# ================================== Markdown ==================================
[*.{md,qmd}]

# 不限制行宽。
max_line_length = unset

# ================================ Windows bat =================================
[*.{bat,cmd}]

# 行尾用 CRLF。
end_of_line = crlf
