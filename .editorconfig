# 本仓文本文件在编辑器保存时的格式。
#
# 规定编码、行尾、行尾空白、末尾换行、缩进与列宽，各节按文件类型覆盖通用节。

# 根配置：工具不再向上查找 .editorconfig。
root = true

# ==================================== 通用 ====================================
[*]
# 编码：UTF-8。
charset = utf-8

# 行尾：LF。
end_of_line = lf

# 行尾空白：保存时删除。
trim_trailing_whitespace = true

# 末尾换行：保存时补一个。
insert_final_newline = true

# 缩进：使用空格。
indent_style = space

# 缩进宽度：每级 2 个空格。
indent_size = 2

# =================================== CMake ====================================
[{CMakeLists.txt,*.cmake}]
# 缩进宽度：每级 4 个空格。
indent_size = 4

# 列宽：单行最多 120 列。
max_line_length = 120

# ================================== C 与 C++ ==================================
[*.{c,cc,cpp,cxx,h,hh,hpp,hxx}]
# 缩进宽度：每级 4 个空格。
indent_size = 4

# 列宽：单行最多 120 列。
max_line_length = 120

# =================================== Shell ====================================
[*.sh]
# 缩进宽度：每级 4 个空格。
indent_size = 4

# 列宽：单行最多 120 列。
max_line_length = 120

# =============================== Windows 批处理 ===============================
[*.{bat,cmd}]
# 行尾：CRLF。
end_of_line = crlf
